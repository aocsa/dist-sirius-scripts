diff --git a/src/op/scan/scan_timing.hpp b/src/op/scan/scan_timing.hpp
new file mode 100644
index 00000000..53f011ab
--- /dev/null
+++ b/src/op/scan/scan_timing.hpp
@@ -0,0 +1,174 @@
