+ * limitations under the License.
+ */
+
+#pragma once
+
+#include "log/logging.hpp"
+
+#include <cuda_runtime_api.h>
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+
+/// Opt-in scan phase timing, enabled by the SIRIUS_SCAN_TIMING environment variable.
+///
+/// Splits a parquet scan task's time into fetch (until the last column-chunk read
+/// completes), decode (the rest of read_parquet, stream-synchronized) and the post-scan
+/// filters. Totals are per process and logged at most every 5 s, so cold and warm
+/// iterations separate by timestamp. Timing adds stream syncs, so leave it off when
+/// measuring end-to-end speed.
+namespace sirius::op::scan::timing {
+
+enum class phase : std::size_t {
+  fetch,
+  decode,
+  static_filter,
+  dynamic_filter,
+  shuffle_route,         ///< EXCHANGE_SINK::execute: hash partition and routing, synced.
+  shuffle_send_blocked,  ///< Pipeline time inside transport::send (back-pressure waits).
+  shuffle_transfer,      ///< Wall time with any outgoing batch still in flight.
+  count
+};
+
+using clock = std::chrono::steady_clock;
+
+[[nodiscard]] inline bool enabled() noexcept
+{
+  static bool const on = std::getenv("SIRIUS_SCAN_TIMING") != nullptr;
+  return on;
+}
+
+[[nodiscard]] inline std::int64_t now_ns() noexcept
+{
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(clock::now().time_since_epoch())
+    .count();
+}
+
+struct totals {
+  std::array<std::atomic<std::int64_t>, static_cast<std::size_t>(phase::count)> ns{};
+  std::atomic<std::uint64_t> splits{0}, reads{0}, read_bytes{0}, rows{0};
+  std::atomic<std::uint64_t> shuffle_batches{0}, shuffle_bytes{0};
+  std::atomic<std::int64_t> last_log_ns{0};
+  // Outgoing batches in flight and when the count last rose from zero.
+  std::atomic<std::int64_t> in_flight{0}, busy_since_ns{0};
+};
+
+[[nodiscard]] inline totals& global() noexcept
+{
+  static totals t;
+  return t;
+}
+
+inline void maybe_log() noexcept
+{
+  auto& t         = global();
+  auto const now  = now_ns();
+  auto last       = t.last_log_ns.load(std::memory_order_relaxed);
+  if (now - last < 5'000'000'000LL) return;
+  if (!t.last_log_ns.compare_exchange_strong(last, now)) return;
+  auto ms = [&](phase p) { return t.ns[static_cast<std::size_t>(p)].load() / 1e6; };
+  // Ranks of one host share a log file; the visible GPU tells them apart.
+  static char const* const gpu = std::getenv("CUDA_VISIBLE_DEVICES");
+  SIRIUS_LOG_INFO(
+    "[scan_timing] gpu {} splits {} reads {} read_MB {:.0f} rows {} | fetch_ms {:.0f} "
+    "decode_ms {:.0f} static_filter_ms {:.0f} dynamic_filter_ms {:.0f} | shuffle_batches {} "
+    "shuffle_MB {:.0f} route_ms {:.0f} send_blocked_ms {:.0f} transfer_ms {:.0f}",
+    gpu ? gpu : "?",
+    t.splits.load(),
+    t.reads.load(),
+    t.read_bytes.load() / 1e6,
+    t.rows.load(),
+    ms(phase::fetch),
+    ms(phase::decode),
+    ms(phase::static_filter),
+    ms(phase::dynamic_filter),
+    t.shuffle_batches.load(),
+    t.shuffle_bytes.load() / 1e6,
+    ms(phase::shuffle_route),
+    ms(phase::shuffle_send_blocked),
+    ms(phase::shuffle_transfer));
+}
+
+/// An outgoing exchange batch of @p bytes was queued for a peer.
+inline void shuffle_enqueued(std::size_t bytes) noexcept
+{
+  auto& t = global();
+  t.shuffle_batches.fetch_add(1, std::memory_order_relaxed);
+  t.shuffle_bytes.fetch_add(bytes, std::memory_order_relaxed);
+  if (t.in_flight.fetch_add(1) == 0) { t.busy_since_ns.store(now_ns()); }
+}
+
+/// An outgoing exchange batch was fully sent (its last reference dropped).
+inline void shuffle_released() noexcept
+{
+  auto& t = global();
+  if (t.in_flight.fetch_sub(1) == 1) {
+    auto const since = t.busy_since_ns.load();
+    if (since != 0) { t.ns[static_cast<std::size_t>(phase::shuffle_transfer)] += now_ns() - since; }
+  }
+}
+
+inline void add(phase p, std::int64_t ns) noexcept
+{
+  global().ns[static_cast<std::size_t>(p)].fetch_add(ns, std::memory_order_relaxed);
+  maybe_log();
+}
+
+/// Adds the time from construction to destruction to @p p, after syncing @p stream.
+class scoped_phase {
+ public:
+  scoped_phase(phase p, cudaStream_t stream) noexcept
+    : _phase(p), _stream(stream), _t0(enabled() ? now_ns() : 0)
+  {
+  }
+  ~scoped_phase()
+  {
+    if (_t0 == 0) return;
+    cudaStreamSynchronize(_stream);
+    add(_phase, now_ns() - _t0);
+  }
+  scoped_phase(scoped_phase const&)            = delete;
+  scoped_phase& operator=(scoped_phase const&) = delete;
+
+ private:
+  phase _phase;
+  cudaStream_t _stream;
+  std::int64_t _t0;
+};
+
+/// Completion record for the reads one scan task issues; see sirius_datasource.
+struct read_sink {
+  std::atomic<std::int64_t> last_done_ns{0};
+  std::atomic<std::uint64_t> reads{0}, bytes{0};
+
+  void record(std::size_t n) noexcept
+  {
+    auto const t = now_ns();
+    auto prev    = last_done_ns.load(std::memory_order_relaxed);
+    while (prev < t && !last_done_ns.compare_exchange_weak(prev, t)) {}
+    reads.fetch_add(1, std::memory_order_relaxed);
+    bytes.fetch_add(n, std::memory_order_relaxed);
+  }
+};
+
+/// The sink that reads issued from this thread report to, or null.
+inline thread_local read_sink* current_sink = nullptr;
+
+}  // namespace sirius::op::scan::timing
